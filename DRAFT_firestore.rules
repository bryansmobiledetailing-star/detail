rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'bryansmobiledetailing@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) 
        && data.keys().size() <= 7
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 255
        && data.role in ['admin', 'customer'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['startAt', 'customer', 'status'])
        && data.keys().size() <= 10
        && data.startAt is string // or timestamp depending on how it's stored
        && data.customer is map
        && data.status in ['pending', 'confirmed', 'cancelled', 'completed'];
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['name', 'email', 'vehicle'])
        && data.keys().size() <= 6
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 255
        && data.vehicle is map;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'customer'; // Default to customer
      allow update: if (isOwner(userId) || isAdmin())
        && isValidUser(incoming())
        && (isAdmin() || (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
            && incoming().uid == existing().uid
            && incoming().role == existing().role
        ));
    }

    match /bookings/{bookingId} {
      allow list: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow get: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && (isAdmin() || (
            resource.data.userId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['customer', 'updatedAt'])
            && incoming().userId == existing().userId
            && incoming().status == existing().status
        ))
        && isValidBooking(incoming());
      allow delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isValidId(quoteId) 
        && isValidQuote(incoming())
        && incoming().createdAt == request.time;
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true; // Public cache
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // System managed or manually set in console
    }
  }
}
